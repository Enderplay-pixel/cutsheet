# Server port (Railway sets this automatically)
PORT=3001

# Set to "production" for deployment
NODE_ENV=development

# Path where the SQLite database file is stored.
# On Railway: set to the persistent volume mount path (e.g. /data)
# Locally: defaults to ./data/cutsheet.db
DATA_DIR=./data

# Path to Chromium binary for Puppeteer PDF generation.
# On Railway with nixpacks this is set automatically via nixpacks.toml.
# On macOS/Linux locally: leave empty (puppeteer downloads its own Chromium).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
