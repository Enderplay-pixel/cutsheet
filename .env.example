# Server port (Railway/Render set this automatically)
PORT=3001

# Set to "production" for deployment
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/cutsheet

# Öffentliche Basis-URL der App — wird für alle Links in E-Mails verwendet
# (Passwort-Reset, Einladungen, Dispo-Links). In Produktion zwingend setzen!
APP_BASE_URL=http://localhost:5173

# JWT-Secret für Login-Tokens — in Produktion zwingend ändern!
JWT_SECRET=

# Path to Chromium binary for Puppeteer PDF generation.
# On Railway with nixpacks this is set automatically via nixpacks.toml.
# On macOS/Linux locally: leave empty (puppeteer downloads its own Chromium).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ── E-Mail (optional — ohne diese Vars wird Versand übersprungen und nur geloggt) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CutSheet <noreply@cutsheet.app>"

# ── Web Push (optional — npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@cutsheet.app

# ── Claude API (KI-Features: Script-Breakdown, Auto-Scheduling) ──
ANTHROPIC_API_KEY=

# ── Client (client/.env) ──
# PostHog EU Produktanalytik — ohne Key komplett deaktiviert (kein Netzwerk-Call)
# VITE_POSTHOG_KEY=phc_...

# ── YouTube-Anbindung (optional) ──
# OAuth-Client aus der Google Cloud Console, Typ "Webanwendung".
# Benoetigte APIs: YouTube Data API v3 und YouTube Analytics API.
# Autorisierte Redirect-URI muss exakt so eingetragen sein:
#   <APP_BASE_URL>/api/creator/youtube/callback
# Achtung: yt-analytics.readonly ist ein sensibler Scope. Solange die App im
# Google-Testmodus laeuft, verfallen Refresh-Tokens nach 7 Tagen.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Nur setzen, wenn die Redirect-URI vom Standard abweicht
# YOUTUBE_REDIRECT_URI=

# Schluessel fuer die Verschluesselung gespeicherter YouTube-Tokens.
# Ohne diesen Wert wird JWT_SECRET verwendet.
TOKEN_ENCRYPTION_KEY=

# ── Zugang & Testversion ──
# Dieses Konto ist immer Admin (auch wenn es nicht das erste ist).
# ADMIN_EMAIL=
# Test-Admin fuer die Testphase. In Produktion wird er NUR angelegt, wenn
# beide Werte gesetzt sind (Passwort mindestens 12 Zeichen).
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# 1 = App zeigt ueberall ein "Test"-Kennzeichen (Testphase vor dem Launch)
# CUTSHEET_TESTVERSION=1

# ── Betrieb unter Last (Vorgaben passen fuer die meisten Instanzen) ──
# Verbindungen zur Datenbank je Server-Prozess
# DB_POOL_MAX=20
# So lange wartet eine Anfrage auf eine freie Verbindung, danach 503
# DB_CONNECT_TIMEOUT_MS=15000
# Obergrenze fuer eine einzelne Abfrage
# DB_STATEMENT_TIMEOUT_MS=30000
# Gleichzeitig gerenderte PDFs (bei 512 MB RAM: 1)
# PDF_MAX_PARALLEL=2
# Anzahl vertrauter Proxy-Stufen vor dem Server (Railway/Render: 1)
# TRUST_PROXY=1
